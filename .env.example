# Copy this file to .env and fill in your key.
# Get a key at https://developer.clashroyale.com (keys are locked to the IP you register).
CR_API_KEY=

# Optional: use the RoyaleAPI proxy when deploying somewhere without a fixed IP.
# Whitelist the proxy's IP on your key (see https://docs.royaleapi.com/proxy.html), then set:
# CR_API_BASE_URL=https://proxy.royaleapi.dev/v1
